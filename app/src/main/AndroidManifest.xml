<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        NFR 1.5: android.permission.INTERNET is intentionally NOT declared so that
        any accidental network IO at runtime will fail-fast (SecurityException).
        NFR 4.1: BIND_ACCESSIBILITY_SERVICE is intentionally NOT declared (no a11y dep).
        NFR 4.3: no DeviceOwner / root permissions.
    -->

    <queries>
        <!-- PackageSignatureResolver / PackagePickerBottomSheet need to enumerate
             installed apps so the launcher activities are queryable on API 30+. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".KeyNestApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeyNest">

        <!--
            Launcher activity. Concrete UI activities are added in T9.x.
            For T1.4 a placeholder Activity is wired so that the app is launchable
            and the assembleDebug task passes.
        -->
        <activity
            android:name=".ui.list.CredentialListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            T8.5: AutofillService entry point. android:permission ensures only
            the framework can bind. excludeFromRecents prevents the unlock
            activity from appearing in the recent-apps list.
        -->
        <service
            android:name=".autofill.KeyNestAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

        <!-- T8.6: Authentication intent target for locked datasets. -->
        <activity
            android:name=".autofill.unlock.AutofillUnlockActivity"
            android:theme="@style/Theme.KeyNest.Translucent"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- T9.2 / T9.4 -->
        <activity
            android:name=".ui.edit.CredentialEditActivity"
            android:exported="false"
            android:label="@string/credential_edit_title_new" />

        <activity
            android:name=".ui.enable.AutofillEnableActivity"
            android:exported="false"
            android:label="@string/autofill_enable_title" />

        <!-- Issue #10 Req 1.2 / 1.3 -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.list.CredentialListActivity" />

        <!-- Issue #10 Req 6.3 / 7.x -->
        <activity
            android:name=".ui.danger.DangerZoneActivity"
            android:exported="false"
            android:label="@string/danger_zone_title"
            android:parentActivityName=".ui.settings.SettingsActivity" />

        <!-- Issue #10 Req 5.3 -->
        <activity
            android:name=".ui.oss.OssLicensesActivity"
            android:exported="false"
            android:label="@string/oss_licenses_title"
            android:parentActivityName=".ui.settings.SettingsActivity" />

        <!--
            Issue #90 / Parent #89:
            CredentialProviderService の最小骨格。Android 14 (API 34) 以降の OS
            の「パスワードと PassKey」設定画面に KeyNest を PassKey プロバイダ
            候補として表示させるための宣言。本 Issue では 3 callback は空応答。
            登録 / 認証セレモニーの実体は後続 Issue で差し替える。
        -->
        <service
            android:name=".credentialprovider.KeyNestCredentialProviderService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE"
            tools:targetApi="34">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>

    </application>

</manifest>
