<?xml version="1.0" encoding="utf-8"?>
<!--
    OutlinedBox TextField stroke state list.
    - focused → primary (2dp via boxStrokeWidthFocused)
    - error   → danger
    - default → border_strong (matches `design/screens/screens-1.jsx` Field)
    AC 4.4.3
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/kn_danger" android:state_activated="true"/>
    <item android:color="@color/kn_primary" android:state_focused="true"/>
    <item android:color="@color/kn_primary" android:state_pressed="true"/>
    <item android:color="@color/kn_primary" android:state_hovered="true"/>
    <item android:color="@color/kn_border_strong"/>
</selector>
