<?xml version="1.0" encoding="utf-8"?>
<!--
    Standard surface card. 1dp border + 20dp radius matches `.kn-card` and
    `CredCard` from screens-1.jsx (AC 4.3.2 / 4.4.2).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/kn_radius_lg" />
    <solid android:color="@color/kn_surface" />
    <stroke android:width="1dp" android:color="@color/kn_border" />
</shape>
