<?xml version="1.0" encoding="utf-8"?>
<!--
    Background for the autofill dropdown dataset row (RemoteViews).
    The autofill UI clips to its own popup chrome so we keep a simple
    surface fill (no rounded corners on individual rows; corners belong
    to the popup container).

    AC 4.7.1
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/kn_surface" />
</shape>
