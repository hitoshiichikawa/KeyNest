<?xml version="1.0" encoding="utf-8"?>
<!--
  KeyNest adaptive icon foreground — Icon B (Filled K-Key).
  108dp x 108dp canvas. The K-shaped key sits inside the safe zone
  (inner 66dp circle around (54,54)); the paper-nest shelter touches
  the edges and is intentionally trimmed by tighter masks.

  Source: design/screens/icons.jsx → IconB.
  Place at: app/src/main/res/drawable/ic_launcher_foreground.xml
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Paper-nest shelter (cream) under the K -->
    <path
        android:pathData="M12.96,90.72 Q54,65.88 95.04,90.72 Z"
        android:fillColor="#F4EBDC"
        android:fillAlpha="0.95"/>

    <!-- K-key: bow (ring) -->
    <path
        android:pathData="M32.4,54 m-11.88,0 a11.88,11.88 0 1,0 23.76,0 a11.88,11.88 0 1,0 -23.76,0"
        android:strokeColor="#F4EBDC"
        android:strokeWidth="7.56"
        android:fillColor="@android:color/transparent"/>

    <!-- K-key: shaft -->
    <path
        android:pathData="M44.28,54 L90.72,54"
        android:strokeColor="#F4EBDC"
        android:strokeWidth="10.8"
        android:strokeLineCap="round"/>

    <!-- K-key: teeth -->
    <path
        android:pathData="M74.52,54 L74.52,71.28"
        android:strokeColor="#F4EBDC"
        android:strokeWidth="7.56"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M85.32,54 L85.32,65.88"
        android:strokeColor="#F4EBDC"
        android:strokeWidth="7.56"
        android:strokeLineCap="round"/>

    <!-- Bow centerpoint (brand blue dot) -->
    <path
        android:pathData="M32.4,54 m-3.24,0 a3.24,3.24 0 1,0 6.48,0 a3.24,3.24 0 1,0 -6.48,0"
        android:fillColor="#1F6FEB"/>
</vector>
