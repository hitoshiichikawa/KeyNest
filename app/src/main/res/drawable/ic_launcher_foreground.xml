<?xml version="1.0" encoding="utf-8"?>
<!--
  KeyNest adaptive icon foreground.
  108dp x 108dp canvas. The visible safe zone is the inner 66x66 square /
  72dp circle centered at (54, 54). The roof peak and twig tips are
  intentionally placed outside this zone so they only show on
  squircle/square masks — the keyhole (the recognizable mark) is fully
  inside the safe zone.

  Source: KeyNest Design / IconA (cream shelter + blue gradient roof).
  Drop into: app/src/main/res/drawable/ic_launcher_foreground.xml
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tan nest base (behind the roof) -->
    <path
        android:pathData="M9.72,85.32 Q54,71.28 98.28,85.32 L98.28,99.36 Q54,90.72 9.72,99.36 Z"
        android:fillColor="#D9C3A0"/>

    <!-- Shelter / roof with brand gradient -->
    <path android:pathData="M11.88,84.24 Q54,11.88 96.12,84.24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="11.88" android:startY="11.88"
                android:endX="96.12"  android:endY="84.24">
                <item android:offset="0" android:color="#FF2A7BF5"/>
                <item android:offset="1" android:color="#FF0F4AA8"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Keyhole — bow (inside safe zone) -->
    <path
        android:pathData="M54,52.92 m-9.72,0 a9.72,9.72 0 1,0 19.44,0 a9.72,9.72 0 1,0 -19.44,0 Z"
        android:fillColor="#F4EBDC"/>
    <!-- Keyhole — stem -->
    <path
        android:pathData="M49.14,59.4 L47.52,79.92 L60.48,79.92 L58.86,59.4 Z"
        android:fillColor="#F4EBDC"/>

    <!-- Twigs -->
    <path
        android:pathData="M16.2,93.96 L38.88,90.72"
        android:strokeColor="#9B7A4A"
        android:strokeWidth="2.16"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M69.12,90.72 L91.8,93.96"
        android:strokeColor="#9B7A4A"
        android:strokeWidth="2.16"
        android:strokeLineCap="round"/>
</vector>
