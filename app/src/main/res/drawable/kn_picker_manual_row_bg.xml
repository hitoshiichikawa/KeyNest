<?xml version="1.0" encoding="utf-8"?>
<!--
  Issue #32 Req 8.3: manual-entry fallback row background.

  JSX `ScreenPicker` reference (screens-2.jsx L53-56):
    width 100%, padding 12, color=text-2, font 600 13px,
    (the JSX renders this as `background: transparent` but Issue DoD #7
    explicitly says kn_blue_50). We follow the Issue DoD here because the
    requirements (Req 8.3) lock the visual to kn_blue_50.

  Fill: @color/kn_blue_50 — the light palette tint. values-night redefines
  this category through `kn_primary_container` (= #1A2D5C, a dim blue
  surface) but `kn_blue_50` itself is a raw palette color and is NOT
  redefined in dark mode. We therefore reference the semantic alias
  `kn_primary_container` via a -night drawable override to preserve
  Req 10.5 (dark mode contrast ≥ 4.5:1 for the kn_primary text on the
  filled background).

  Corners: kn_r_sm (12dp) so the pill aligns with the surrounding row
  radius. Adopted for visual coherence with the section header row r12.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/kn_blue_50" />
    <corners android:radius="@dimen/kn_r_sm" />
</shape>
