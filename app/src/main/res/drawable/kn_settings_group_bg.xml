<?xml version="1.0" encoding="utf-8"?>
<!--
  Issue #33 Req 3.1 / 3.2 / 3.3: SettingGroup (共通コンテナ) 背景.

  JSX `SettingGroup` reference (screens-2.jsx L303):
    background: var(surface),
    border: 1px solid var(border),
    borderRadius: 16,
    overflow: hidden.

  Fill: @color/kn_surface (light: white / dark: ink_850).
  Border: @color/kn_border (light: rgba ink @ 8% / dark: rgba white @ 6%).
  Corners: @dimen/kn_r_md (16dp).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/kn_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/kn_border" />
    <corners android:radius="@dimen/kn_r_md" />
</shape>
