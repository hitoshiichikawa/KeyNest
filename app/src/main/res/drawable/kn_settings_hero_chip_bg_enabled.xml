<?xml version="1.0" encoding="utf-8"?>
<!--
  Issue #33 Req 2.6: Autofill status chip background (Enabled state).

  JSX `ScreenSettings` reference (screens-2.jsx L259):
    padding '4px 9px',
    background: rgba(255,255,255,.2),
    borderRadius: 999.

  hex ARGB の #33FFFFFF = alpha 0x33 (= 51 / 255 ≈ 20%) + #FFFFFF = 白 20% 透過.
  この値は light/dark どちらの hero gradient 上でも 同じ alpha 比で白チップ
  として可読 (white-on-blue contrast > 4.5:1).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#33FFFFFF" />
    <corners android:radius="@dimen/kn_r_pill" />
</shape>
