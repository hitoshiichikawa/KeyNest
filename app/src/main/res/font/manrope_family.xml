<?xml version="1.0" encoding="utf-8"?>
<!--
    Issue #28 Phase 1 — Manrope ファミリ (weight 別).
    design/android-assets/res/font/manrope_family.xml をベースに、
    Downloadable Fonts (Google Fonts provider) 参照を Issue #13 でバンドル
    した TTF (manrope_*.ttf in app/src/main/res/font/) への参照に置き換え
    たもの。

    NFR 1.5 / Issue #13: INTERNET 権限を追加せず APK 内 TTF だけで解決
    するため、Downloadable Fonts API は使わない。

    バンドルされている weight:
      - 400 Regular   (manrope_regular.ttf)
      - 500 Medium    (manrope_medium.ttf)
      - 600 SemiBold  (manrope_semibold.ttf)
      - 700 Bold      (manrope_bold.ttf)

    weight 800 (ExtraBold) は Issue #13 NFR 1.1 に従い APK には同梱しない。
    weight 800 を要求されたケースは framework の closest-match 解決で
    weight 700 にフォールバックする (Out of Scope に明記).
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/manrope_regular"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:font="@font/manrope_regular" />

    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/manrope_medium"
        app:fontStyle="normal"
        app:fontWeight="500"
        app:font="@font/manrope_medium" />

    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/manrope_semibold"
        app:fontStyle="normal"
        app:fontWeight="600"
        app:font="@font/manrope_semibold" />

    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/manrope_bold"
        app:fontStyle="normal"
        app:fontWeight="700"
        app:font="@font/manrope_bold" />

</font-family>
