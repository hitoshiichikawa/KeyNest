<?xml version="1.0" encoding="utf-8"?>
<!--
    Credential edit screen.

    Maps `design/screens/screens-1.jsx` <ScreenEdit/>:
      - top app bar with close icon, centered title, primary "保存" text action
      - "Target app" card: IconTile + display name + monospace package
        name + "署名取得済み" chip
      - Outlined fields (label / username / password) with eyebrow labels
      - Password field uses monospace + .1em letter spacing on the value
      - Destructive delete button (only shown in edit mode via existing
        Kotlin logic — id `btn_delete` for any future wiring)

    Existing Kotlin uses ViewBinding ids `toolbar`, `layout_package`,
    `input_package`, `btn_pick_installed_app`, `layout_username`,
    `input_username`, `layout_password`, `input_password`, `layout_label`,
    `input_label`, `btn_save` — all preserved verbatim (NFR 3.2).

    Requirements: 4.4.1-4.4.7, NFR 3.2
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:navigationIcon="@drawable/ic_kn_close"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/credential_edit_title_new"
        app:titleCentered="true"
        app:titleTextAppearance="@style/TextAppearance.KeyNest.CardTitle">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/Widget.KeyNest.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/kn_space_3"
            android:text="@string/action_save"
            android:textColor="?attr/colorPrimary" />
    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/kn_pad_screen_horizontal"
        android:paddingBottom="@dimen/kn_space_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
                Target app card — IconTile + label + monospace package +
                signature chip. The IconTile letter is set programmatically
                so it follows the first character of the display-name input
                live (Kotlin update is optional; the design value falls
                back to "K" until the user types).
            -->
            <LinearLayout
                android:id="@+id/target_app_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kn_space_2"
                android:background="@drawable/bg_card_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/kn_space_4"
                android:paddingVertical="@dimen/kn_space_3">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_tile_primary">

                    <TextView
                        android:id="@+id/target_icon_letter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/kn_on_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="K" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/kn_space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/target_app_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/label_target_app"
                        android:textAppearance="@style/TextAppearance.KeyNest.CardTitle"
                        tools:text="Salesforce Mobile" />

                    <TextView
                        android:id="@+id/target_package_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.KeyNest.Mono"
                        tools:text="com.salesforce.chatter" />

                    <LinearLayout
                        android:id="@+id/target_signature_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_chip_success"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/kn_space_2"
                        android:paddingVertical="3dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_kn_shield"
                            app:tint="@color/kn_success" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/signature_captured_chip"
                            android:textColor="@color/kn_success"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_installed_app"
                    style="@style/Widget.KeyNest.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/action_pick_installed_app"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <!-- Hidden package input — its value still drives the underlying
                 save flow. The visible package name is mirrored on the target
                 app card above. ViewBinding id `input_package` and
                 `layout_package` are preserved (NFR 3.2). -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_package"
                style="@style/Widget.KeyNest.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kn_space_4"
                android:hint="@string/label_package_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_package"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:imeOptions="actionNext"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Display name (label) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_label"
                style="@style/Widget.KeyNest.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kn_space_3"
                android:hint="@string/label_display_name"
                app:helperText="@string/label_display_name_help"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Username / email -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_username"
                style="@style/Widget.KeyNest.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kn_space_3"
                android:hint="@string/label_username">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--
                Password field: monospace + .1em letter spacing on the
                value glyphs (AC 4.4.4). Material's passwordToggleEnabled
                preserves the existing eye/eye-off affordance (AC 4.4.5).
            -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_password"
                style="@style/Widget.KeyNest.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kn_space_3"
                android:hint="@string/label_password"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/kn_text_2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:letterSpacing="0.1"
                    android:textSize="17sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--
                Hidden "Save" button preserved for adapters / tests that
                still look up `binding.btnSave` outside the toolbar.
                Same id (`btn_save`) lives on the toolbar action above;
                Material's ViewBinding generator namespaces by id so
                exposing only one `btnSave` member here is enough.
            -->

            <!--
                Destructive delete (edit mode only). Hidden by default;
                CredentialEditActivity already finishes after save, and
                deletion currently happens via long-press on the list.
                The button is wired through `btn_delete` for future
                in-editor delete (Issue #5 leaves the visual hook ready
                while staying functionally identical — see impl-notes).
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete"
                style="@style/Widget.KeyNest.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kn_space_5"
                android:text="@string/action_delete_credential_destructive"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
