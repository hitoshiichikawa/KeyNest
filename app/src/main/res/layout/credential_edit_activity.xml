<?xml version="1.0" encoding="utf-8"?>
<!--
  Issue #30: credential edit screen.

  Source of truth:
  - JSX: design/screens/screens-1.jsx > ScreenEdit (lines 314-364).
  - Token mapping: design/android-assets/mapping.md §5 / §8.

  Visual contract (per Requirement):
  - Root background (Req 1.1): ?android:attr/colorBackground → resolves to
    kn_bg via the Theme.KeyNest android:colorBackground bridge.
  - Scroll region horizontal padding (Req 1.2): kn_screen_padding_h (20dp).
  - Section vertical gaps (Req 1.3): chosen from @dimen/kn_space_* tokens
    (4 / 8 / 12 / 16 / 20 / 24dp).
  - App bar (Req 2.x): MaterialToolbar with Text.KeyNest.TitleS title
    appearance, ic_close_24 navigation icon tinted kn_text. The Activity
    sets the title via setSupportActionBar(toolbar) + title = ... and
    swaps `credential_edit_title_new` / `credential_edit_title_edit`.
  - Target app card (Req 3.x): Widget.KeyNest.Card (kn_surface + kn_border
    + r_card) with kn_card_padding (14dp) inset. A 44dp / r_sm icon tile
    (kn_blue_500 single-color fallback per Out of Scope), a two-line
    label/package column, a signature chip (success/warning bg swapped
    by adapter), and the "Change" CTA (btn_pick_installed_app preserved).
  - Hidden editable package field (Req 3.9 / 10.1): layout_package /
    input_package are kept in the XML at visibility=gone so the existing
    PackagePickerBottomSheet callback (binding.inputPackage.setText) and
    onSaveClicked() read path remain intact; the visible representation
    of the package name is `tv_target_app_package`.
  - TextInputLayouts (Req 4.x / 5.x): Widget.KeyNest.TextField style,
    kn_input_height min, Text.KeyNest.Body input text, kn_text_2 hint
    color. Password field gets Text.KeyNest.Password textAppearance.
  - Password strength bar (Req 6.x): com.example.keynest.ui.widget.StrengthBar
    placed in a header row next to the password label. Default GONE (the
    domain has no strength field — Issue #29 確認事項 #2 with same
    rationale).
  - Advanced section (Req 7.x): kn_advanced_section_bg + kn_card_padding
    inset + chevron rotation preserved from Issue #14. Existing ids and
    behaviours are all preserved (Req 10.1 / 10.4 / 10.5 / 10.6).
  - Delete CTA (Req 8.x): Widget.KeyNest.Button.Destructive button below
    the advanced section. Visibility is GONE by default; the Activity
    flips it to VISIBLE in edit mode (editingId != null).
  - Save CTA (Req 9.x): bottom-aligned primary button styled with
    Widget.KeyNest.Button.Primary. Existing id/btn_save preserved
    (Req 9.5 / 10.2).

  IDs preserved from Req 10.1: toolbar / layout_package / input_package /
  btn_pick_installed_app / layout_username / input_username / layout_password
  / input_password / layout_label / input_label / btn_save / advanced_header
  / advanced_title / advanced_chevron / advanced_content / row_created_at /
  value_created_at / row_updated_at / value_updated_at / row_signature_hex /
  value_signature_hex / btn_copy_signature_hex / row_signature_captured_at /
  value_signature_captured_at / row_credential_id / value_credential_id /
  toggle_credential_id.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?android:attr/colorBackground"
        app:navigationContentDescription="@string/credential_edit_close_a11y"
        app:navigationIcon="@drawable/ic_close_24"
        app:navigationIconTint="@color/kn_text"
        app:titleTextAppearance="@style/Text.KeyNest.TitleS"
        app:titleTextColor="@color/kn_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/kn_screen_padding_h"
        android:paddingBottom="@dimen/kn_space_6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
              Target app card (Req 3.x). Width=match_parent, internal layout
              follows the JSX flex: icon tile + (label/package/chip column)
              + change button.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_target_app"
                style="@style/Widget.KeyNest.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kn_space_2"
                android:layout_marginBottom="@dimen/kn_space_6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/kn_card_padding"
                    android:paddingVertical="@dimen/kn_card_padding">

                    <!--
                      Icon tile (Req 3.3 / 3.4): 44dp / r12 / kn_blue_500.
                      Per-credential color and dynamic letter overlay are
                      Out of Scope; we render the bare tile as a visual
                      placeholder consistent with the credential list rows.
                    -->
                    <FrameLayout
                        android:layout_width="@dimen/kn_icon_tile_lg"
                        android:layout_height="@dimen/kn_icon_tile_lg"
                        android:layout_marginEnd="@dimen/kn_space_3"
                        android:background="@drawable/kn_icon_tile_bg" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!--
                          App name display row (Req 3.5). The Activity
                          mirrors the value of input_label here; for new
                          mode the placeholder "新しいクレデンシャル" /
                          "New credential" is used.
                        -->
                        <TextView
                            android:id="@+id/tv_target_app_label"
                            style="@style/Text.KeyNest.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            tools:text="Salesforce Mobile" />

                        <!--
                          Package name mono display (Req 3.6). Mirrors
                          input_package text. kn_text_2 + Mono 12sp.
                        -->
                        <TextView
                            android:id="@+id/tv_target_app_package"
                            style="@style/Text.KeyNest.Mono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/kn_text_2"
                            tools:text="com.salesforce.chatter" />

                        <!--
                          Signature chip (Req 3.7 / 3.8). Background drawable
                          and text color/string are swapped by the Activity
                          based on Credential.signatureSha256:
                            non-null → kn_signature_chip_bg_success +
                                       kn_success + @string/signature_match
                            null     → kn_signature_chip_bg_warning +
                                       kn_warning + @string/signature_missing
                        -->
                        <LinearLayout
                            android:id="@+id/chip_signature_edit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/kn_space_1"
                            android:background="@drawable/kn_signature_chip_bg_warning"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/kn_space_2"
                            android:paddingVertical="2dp">

                            <ImageView
                                android:id="@+id/icon_signature_edit"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="4dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_shield_fill_16"
                                app:tint="@color/kn_warning" />

                            <TextView
                                android:id="@+id/text_signature_edit"
                                style="@style/Text.KeyNest.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/signature_missing"
                                android:textColor="@color/kn_warning" />
                        </LinearLayout>
                    </LinearLayout>

                    <!--
                      "Change" CTA (existing btn_pick_installed_app). The
                      JSX renders a tiny "変更" text button here; we map it
                      to Widget.KeyNest.Button.Text which already styles the
                      label as kn_primary / Text.KeyNest.LabelL with a
                      44dp tap target. The existing PackagePickerBottomSheet
                      click handler in CredentialEditActivity stays wired to
                      this ID (Req 3.9 / 10.3).
                    -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pick_installed_app"
                        style="@style/Widget.KeyNest.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/kn_space_2"
                        android:contentDescription="@string/credential_edit_target_app_change_a11y"
                        android:minWidth="0dp"
                        android:text="@string/action_pick_installed_app" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
              Hidden editable package field (Req 3.9 / 10.1). Kept at
              visibility=gone so the existing PackagePickerBottomSheet
              callback (binding.inputPackage.setText) and the
              onSaveClicked() read path remain intact. The visible
              representation is tv_target_app_package above.

              NOTE: visibility=invisible would also preserve the EditText
              behaviour but still consume vertical space; gone is correct.
              The TextInputLayout still has Widget.KeyNest.TextField as a
              precaution against a future re-show.
            -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_package"
                style="@style/Widget.KeyNest.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/label_package_name"
                android:visibility="gone"
                tools:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_package"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:minHeight="@dimen/kn_input_height"
                    android:textAppearance="@style/Text.KeyNest.Body"
                    android:textColor="@color/kn_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Display name field (Req 4.x). -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_label"
                style="@style/Widget.KeyNest.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/kn_space_3"
                android:hint="@string/label_display_name"
                android:textColorHint="@color/kn_text_2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:minHeight="@dimen/kn_input_height"
                    android:textAppearance="@style/Text.KeyNest.Body"
                    android:textColor="@color/kn_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Username field (Req 4.x). -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_username"
                style="@style/Widget.KeyNest.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/kn_space_3"
                android:hint="@string/label_username"
                android:textColorHint="@color/kn_text_2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:minHeight="@dimen/kn_input_height"
                    android:textAppearance="@style/Text.KeyNest.Body"
                    android:textColor="@color/kn_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--
              Password header row (Req 6.1): "PASSWORD" eyebrow label
              + strength bar right-aligned. The bar visibility is GONE
              by default — domain has no strength field today; the
              Activity calls binding.strengthBarEdit.setStrength(null).
              This row plus the password field together replicate the
              JSX `PasswordField` layout.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/kn_space_1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <TextView
                    android:id="@+id/label_password_eyebrow"
                    style="@style/Text.KeyNest.Eyebrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/credential_edit_password_label" />

                <com.example.keynest.ui.widget.StrengthBar
                    android:id="@+id/strength_bar_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Password field (Req 5.x). -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_password"
                style="@style/Widget.KeyNest.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/kn_space_4"
                android:hint="@string/label_password"
                android:textColorHint="@color/kn_text_2"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/kn_text_2"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:minHeight="@dimen/kn_input_height"
                    android:textAppearance="@style/Text.KeyNest.Password"
                    android:textColor="@color/kn_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--
              Advanced details section (Issue #14 + Issue #30 Req 7.x).

              Container background and corner radius come from
              @drawable/kn_advanced_section_bg (kn_surface_2 + r14). The
              header is a clickable LinearLayout that toggles content
              visibility (existing Issue #14 behaviour preserved); the
              chevron rotation is controlled by
              CredentialEditActivity.chevronRotationFor(expanded).
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kn_advanced_section_bg"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/kn_card_padding"
                android:paddingVertical="@dimen/kn_card_padding">

                <LinearLayout
                    android:id="@+id/advanced_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="@string/advanced_section_header_a11y"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:id="@+id/advanced_title"
                        style="@style/Text.KeyNest.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/advanced_section_title"
                        android:textColor="@color/kn_text_2" />

                    <ImageView
                        android:id="@+id/advanced_chevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/credential_edit_advanced_chevron_a11y"
                        android:src="@drawable/ic_chevron_down_24"
                        app:tint="@color/kn_text_3" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/advanced_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/kn_space_2"
                    android:visibility="gone">

                    <!-- Created at -->
                    <LinearLayout
                        android:id="@+id/row_created_at"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/kn_space_2">

                        <TextView
                            style="@style/Text.KeyNest.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/advanced_label_created_at"
                            android:textColor="@color/kn_text_2" />

                        <TextView
                            android:id="@+id/value_created_at"
                            style="@style/Text.KeyNest.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:longClickable="false"
                            android:textColor="@color/kn_text"
                            android:textIsSelectable="false" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/kn_advanced_row_divider" />

                    <!-- Updated at -->
                    <LinearLayout
                        android:id="@+id/row_updated_at"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/kn_space_2">

                        <TextView
                            style="@style/Text.KeyNest.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/advanced_label_updated_at"
                            android:textColor="@color/kn_text_2" />

                        <TextView
                            android:id="@+id/value_updated_at"
                            style="@style/Text.KeyNest.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:longClickable="false"
                            android:textColor="@color/kn_text"
                            android:textIsSelectable="false" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/kn_advanced_row_divider" />

                    <!-- Signature SHA-256 hex with copy button -->
                    <LinearLayout
                        android:id="@+id/row_signature_hex"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/kn_space_2">

                        <TextView
                            style="@style/Text.KeyNest.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/advanced_label_signature_sha256"
                            android:textColor="@color/kn_text_2" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!--
                              Issue #13 Req 2.2: signature hex uses the
                              bundled JetBrains Mono Regular. The
                              android:fontFamily attribute is set
                              directly (not just via Text.KeyNest.Mono
                              style) because Issue #13's
                              CredentialEditLayoutAuditTest pins the
                              literal attribute on this exact TextView.
                              Keeping both the style and the explicit
                              attribute is a no-op visually but
                              preserves that contract.
                            -->
                            <TextView
                                android:id="@+id/value_signature_hex"
                                style="@style/Text.KeyNest.Mono"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:breakStrategy="simple"
                                android:fontFamily="@font/jetbrains_mono"
                                android:textColor="@color/kn_text"
                                android:textIsSelectable="true" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_copy_signature_hex"
                                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/kn_space_2"
                                android:contentDescription="@string/action_copy_signature_a11y"
                                android:minWidth="48dp"
                                android:minHeight="48dp"
                                android:text="@string/action_copy" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/kn_advanced_row_divider" />

                    <!-- Signature captured at -->
                    <LinearLayout
                        android:id="@+id/row_signature_captured_at"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/kn_space_2">

                        <TextView
                            style="@style/Text.KeyNest.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/advanced_label_signature_captured_at"
                            android:textColor="@color/kn_text_2" />

                        <TextView
                            android:id="@+id/value_signature_captured_at"
                            style="@style/Text.KeyNest.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:longClickable="false"
                            android:textColor="@color/kn_text"
                            android:textIsSelectable="false" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/kn_advanced_row_divider" />

                    <!-- Credential ID row -->
                    <LinearLayout
                        android:id="@+id/row_credential_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/kn_space_2">

                        <TextView
                            style="@style/Text.KeyNest.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/advanced_label_credential_id"
                            android:textColor="@color/kn_text_2" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!--
                              Issue #13 Req 2.2: credential ID uses
                              JetBrains Mono. The android:fontFamily
                              attribute is set directly (not just via
                              Text.KeyNest.Mono style) because Issue #13's
                              FontTypefaceWiringTest pins the literal
                              attribute on this exact TextView. Keeping
                              both the style and the explicit attribute
                              is a no-op visually but preserves that
                              contract.
                            -->
                            <TextView
                                android:id="@+id/value_credential_id"
                                style="@style/Text.KeyNest.Mono"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:focusable="false"
                                android:fontFamily="@font/jetbrains_mono"
                                android:longClickable="false"
                                android:textColor="@color/kn_text"
                                android:textIsSelectable="false" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/toggle_credential_id"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/advanced_toggle_show_id_a11y"
                                android:minWidth="48dp"
                                android:minHeight="48dp"
                                android:text="@string/advanced_toggle_show_id" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!--
              Delete CTA (Req 8.x). The Activity flips visibility to VISIBLE
              when editingId != null (edit mode); new mode keeps it GONE.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete"
                style="@style/Widget.KeyNest.Button.Destructive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kn_space_5"
                android:text="@string/action_delete_credential"
                android:visibility="gone"
                tools:visibility="visible" />

            <!--
              Save CTA (Req 9.x). Bottom-aligned primary button; we picked
              the bottom-CTA placement over the app-bar-text-button option
              from Req 9.1 because (a) the existing CredentialEditActivity
              code wires `binding.btnSave.setOnClickListener` to
              `onSaveClicked()` and the current layout already has it at
              the bottom, (b) the design `JSX ScreenEdit` does show a
              "保存" text button in the app bar but the bottom CTA matches
              the existing tap target / accessibility surface better. The
              app-bar variant is left as a follow-up Issue.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.KeyNest.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kn_space_3"
                android:text="@string/action_save" />

