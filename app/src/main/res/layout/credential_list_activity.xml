<?xml version="1.0" encoding="utf-8"?>
<!--
  Issue #29: credential list screen.

  Source of truth:
  - JSX: design/screens/screens-1.jsx > ScreenListEmpty / ScreenListPopulated.
  - Token mapping: design/android-assets/mapping.md §5 / §6 / §8.

  Visual contract:
  - Root background: ?android:attr/colorBackground → resolves to kn_bg
    via the Theme.KeyNest android:colorBackground bridge (Req 1.1).
    (We use the android: namespace because Theme.KeyNest binds
    android:colorBackground specifically; the M3 ?attr/colorBackground
    alias is not defined on this theme.)
  - Horizontal padding for the scroll region: kn_list_padding_h (16dp)
    (Req 1.2).
  - Search bar: a flat surface_2 pill with kn_r_input radius, leading
    search glyph, and kn_text_3 placeholder. The TextInputLayout keeps
    its existing IDs (layout_search / input_search) so the
    addTextChangedListener wiring in CredentialListActivity.setUpSearch()
    stays intact (Req 2.5 / Req 10.2).
  - Filter chips: Widget.KeyNest.Chip with pill shape and surface / primary
    swap on selection (Req 3.x). singleSelection=true preserved (Req 3.6).
  - Recent header: Text.KeyNest.Eyebrow (Req 4.1).
  - Empty state: hero glow + KeyNest mark + headline + supplemental
    body + primary CTA + security footer (Req 8.x). The previous
    bare TextView (id/empty_view) is preserved underneath the new
    decorative layer so the existing renderEmptyView() setText() path
    keeps working unchanged.

  IDs preserved (Req 10.1): toolbar / input_search / layout_search /
  chip_group_filters / chip_signature_matched / chip_signature_missing /
  btn_sort / recent_header / recent_recycler / recycler / empty_view /
  fab_add.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:liftOnScroll="false">

        <!--
            App bar replicates the React mockup: eyebrow ("KeyNest") above
            the bold "Vault" title. We keep using MaterialToolbar so the
            existing setSupportActionBar()/options-menu pipeline keeps
            working, but suppress its built-in title and render the
            eyebrow + title via the children below.
        -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?android:attr/colorBackground"
            app:title="@string/credential_list_title"
            app:titleTextAppearance="@style/Text.KeyNest.TitleS" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!--
          Search + sort row (Req 2.x). Outer layout supplies the 16dp
          horizontal padding (kn_list_padding_h) the design demands.
          The TextInputLayout style is changed to FilledBox with a
          surface_2 fill so the rendered look matches the JSX SearchBar.
          The search glyph is provided via startIconDrawable.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/kn_list_padding_h"
            android:paddingTop="@dimen/kn_space_2"
            android:paddingEnd="@dimen/kn_space_2"
            android:paddingBottom="@dimen/kn_space_1">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_search"
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/credential_list_search_hint"
                android:textColorHint="@color/kn_text_3"
                app:boxBackgroundColor="@color/kn_surface_2"
                app:boxCornerRadiusBottomEnd="@dimen/kn_r_input"
                app:boxCornerRadiusBottomStart="@dimen/kn_r_input"
                app:boxCornerRadiusTopEnd="@dimen/kn_r_input"
                app:boxCornerRadiusTopStart="@dimen/kn_r_input"
                app:boxStrokeColor="@color/kn_border"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search_24"
                app:startIconTint="@color/kn_text_3">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_search"
                    style="@style/Text.KeyNest.BodyS"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/credential_list_search_a11y"
                    android:hint="@string/credential_list_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/kn_text"
                    android:textColorHint="@color/kn_text_3" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/btn_sort"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/kn_space_1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/credential_list_sort_button_a11y"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/kn_text_3" />
        </LinearLayout>

        <!--
          Filter chips (Req 3.x). The chip styles continue to live on
          Widget.Material3.Chip.Filter for the M3 Chip's
          checkable behaviour but inherit via Widget.KeyNest.Chip for
          shape + dimens + typography overrides. The chip background +
          stroke + text color follow the Widget.KeyNest.Chip baseline;
          state colors (kn_primary fill on selection) come from the
          theme's colorPrimary.
        -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/kn_list_padding_h"
            android:paddingTop="@dimen/kn_space_2"
            android:paddingEnd="@dimen/kn_list_padding_h"
            android:paddingBottom="@dimen/kn_space_2"
            app:selectionRequired="false"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_signature_matched"
                style="@style/Widget.KeyNest.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/credential_list_chip_signature_matched" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_signature_missing"
                style="@style/Widget.KeyNest.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/credential_list_chip_signature_missing" />
        </com.google.android.material.chip.ChipGroup>

        <!--
          Recently-used carousel: eyebrow header + horizontal recycler.
          Hidden as a block when recentList is empty (Req 4.6 / 4.7,
          existing behaviour preserved in renderRecentVisibility()).
        -->
        <TextView
            android:id="@+id/recent_header"
            style="@style/Text.KeyNest.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/kn_list_padding_h"
            android:paddingTop="@dimen/kn_space_3"
            android:paddingEnd="@dimen/kn_list_padding_h"
            android:paddingBottom="@dimen/kn_space_2"
            android:text="@string/credential_list_recent_header"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recent_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="@dimen/kn_list_padding_h"
            android:paddingTop="@dimen/kn_space_1"
            android:paddingEnd="@dimen/kn_list_padding_h"
            android:paddingBottom="@dimen/kn_space_3"
            android:visibility="gone"
            tools:listitem="@layout/credential_list_recent_item"
            tools:visibility="visible" />

        <!-- Main list area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/kn_list_padding_h"
                android:paddingTop="@dimen/kn_space_1"
                android:paddingEnd="@dimen/kn_list_padding_h"
                android:paddingBottom="@dimen/kn_space_12"
                tools:listitem="@layout/credential_list_item" />

            <!--
              Empty state (Req 8.x). The existing id/empty_view TextView is
              kept inside this container so the existing
              renderEmptyView() setText() / setVisibility() logic keeps
              working unchanged; it is now styled as the headline and
              wrapped inside a vertical LinearLayout that adds the hero
              glow + KeyNest mark + body copy + primary CTA + footer.

              When emptyKind==NoMatch the activity only shows the
              empty_view TextView (Req 8.5). The decorative wrapper has
              id/empty_state_hero and is toggled together with the
              wrapper via the activity, so NoMatch hides the hero pieces.
            -->
            <LinearLayout
                android:id="@+id/empty_state_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/kn_space_6"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:id="@+id/empty_state_hero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/kn_space_6">

                    <View
                        android:layout_width="128dp"
                        android:layout_height="128dp"
                        android:layout_gravity="center"
                        android:background="@drawable/kn_empty_hero_glow" />

                    <ImageView
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@mipmap/ic_launcher" />
                </FrameLayout>

                <TextView
                    android:id="@+id/empty_view"
                    style="@style/Text.KeyNest.TitleM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/credential_list_empty" />

                <!--
                  Req 8.1 / 8.3: supplemental body copy between the
                  headline (TitleM) and the primary CTA. Uses
                  Text.KeyNest.Body + kn_text_2 as required by the AC.
                  Visible only on EmptyKind.Initial; the activity toggles
                  it together with the hero / CTA / footer so NoMatch
                  shows only the headline.
                -->
                <TextView
                    android:id="@+id/empty_state_body"
                    style="@style/Text.KeyNest.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kn_space_3"
                    android:gravity="center"
                    android:text="@string/credential_list_empty_body"
                    android:textColor="@color/kn_text_2" />

                <!--
                  Primary CTA mirrors the FAB target (CredentialEditActivity).
                  Visible only on EmptyKind.Initial; toggled by the activity.
                -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/empty_state_cta"
                    style="@style/Widget.KeyNest.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kn_space_6"
                    android:minWidth="220dp"
                    android:text="@string/action_add_credential"
                    app:icon="@drawable/ic_plus_24"
                    app:iconGravity="textStart"
                    app:iconTint="@color/kn_on_primary" />

                <TextView
                    android:id="@+id/empty_state_footer"
                    style="@style/Text.KeyNest.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kn_space_6"
                    android:gravity="center"
                    android:text="@string/credential_list_empty_security_note"
                    android:textColor="@color/kn_text_3" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!--
        Floating action button — kept (vs. the React mockup's inline CTA)
        so the existing CredentialListActivity Kotlin code that wires
        `binding.fabAdd.setOnClickListener` keeps working (Req 4.3.5 /
        NFR 3.2). The visual now uses the brand primary as the tint
        token instead of a hard-coded color.
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/kn_space_4"
        android:contentDescription="@string/action_add_credential"
        app:srcCompat="@drawable/ic_plus_24"
        app:tint="@color/kn_on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
