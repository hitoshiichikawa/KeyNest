<?xml version="1.0" encoding="utf-8"?>
<!--
    Credential list screen.

    Maps `design/screens/screens-1.jsx` <ScreenListPopulated/> and
    <ScreenListEmpty/> onto a single XML layout. The populated state
    uses the existing RecyclerView (recycler) with the redesigned
    credential_list_item; the empty state is a vertical composition
    centered in the available area (brand mark + headline + body +
    primary CTA + footer).

    IDs kept verbatim: toolbar, recycler, fab_add, empty_view
    (text_already_enabled is not relevant here).

    Requirements: 4.3.1-4.3.6, 4.9.1, 4.9.2, NFR 3.2
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <!--
            App bar replicates the React mockup: eyebrow ("KeyNest") above
            the bold "Vault" title. We keep using MaterialToolbar so the
            existing setSupportActionBar()/options-menu pipeline keeps
            working, but suppress its built-in title and render the
            eyebrow + title via the children below.
        -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minHeight="?attr/actionBarSize"
            android:paddingHorizontal="@dimen/kn_pad_list_horizontal"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:title="@null">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="@string/credential_list_eyebrow"
                    android:textAppearance="@style/TextAppearance.KeyNest.Meta"
                    android:textColor="@color/kn_text_2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/credential_list_title"
                    android:textAppearance="@style/TextAppearance.KeyNest.AppBarTitle" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="@dimen/kn_space_2"
        android:paddingBottom="96dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/credential_list_item" />

    <!--
        Empty-state composition. Visibility is toggled by
        CredentialListActivity (`binding.emptyView.visibility = ...`).
        The root keeps id `empty_view` so existing Kotlin code continues
        to compile (NFR 3.2). The CTA delegates to the FAB programmatic
        click, see CredentialListActivity for the wiring; the FAB stays
        as the canonical entry point (Req 4.3.5 —機能ロジック不変).
    -->
    <LinearLayout
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/kn_space_8"
        android:paddingVertical="@dimen/kn_space_10"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="18dp"
                android:background="@drawable/bg_mark_halo" />

            <ImageView
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_kn_mark" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kn_space_6"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:text="@string/credential_list_empty_title"
            android:textAppearance="@style/TextAppearance.KeyNest.SectionTitle"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kn_space_3"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/credential_list_empty_description"
            android:textAppearance="@style/TextAppearance.KeyNest.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_empty_cta"
            style="@style/Widget.KeyNest.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kn_space_6"
            android:minWidth="220dp"
            android:text="@string/action_add_credential"
            app:icon="@drawable/ic_kn_plus"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorOnPrimary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kn_space_6"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_kn_shield"
                app:tint="@color/kn_text_3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/kn_space_2"
                android:text="@string/credential_list_empty_footer"
                android:textAppearance="@style/TextAppearance.KeyNest.Meta"
                android:textColor="@color/kn_text_3" />
        </LinearLayout>
    </LinearLayout>

    <!--
        Floating action button — kept (vs. the React mockup's inline CTA)
        so the existing CredentialListActivity Kotlin code that wires
        `binding.fabAdd.setOnClickListener` keeps working (Req 4.3.5 /
        NFR 3.2). The visual now uses the brand primary as the tint
        token instead of a hard-coded color.
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        style="@style/Widget.KeyNest.FloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/kn_pad_screen_horizontal"
        android:contentDescription="@string/action_add_credential"
        app:srcCompat="@drawable/ic_kn_plus" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
