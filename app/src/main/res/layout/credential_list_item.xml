<?xml version="1.0" encoding="utf-8"?>
<!--
    CredCard — matches `design/screens/screens-1.jsx` <CredCard/>.

    Layout: 44dp brand IconTile, label (15sp/700), username (12sp/500
    text-2), monospace package name (11sp/500 text-3). 1dp border,
    20dp radius.

    IDs preserved (text_label, text_subtitle) — adapter and existing
    Kotlin code consume those (NFR 3.2). The Round 2 fix splits the
    sub-line into two TextViews:
      - `text_subtitle` carries the username only (12sp/500 text-2).
      - `text_package` carries the package name (11sp/500 text-3,
        monospace) per AC 4.3.1 / 4.2.2.

    Requirements: 4.3.1, 4.3.2, 4.2.2
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/kn_pad_list_horizontal"
    android:layout_marginVertical="@dimen/kn_space_1"
    android:background="@drawable/bg_card_surface"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/kn_target_min"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/kn_pad_card"
    android:paddingVertical="@dimen/kn_space_3">

    <FrameLayout
        android:layout_width="@dimen/kn_icontile_lg"
        android:layout_height="@dimen/kn_icontile_lg"
        android:background="@drawable/bg_icon_tile_primary">

        <TextView
            android:id="@+id/text_icon_letter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/kn_on_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="K" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/kn_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.KeyNest.CardTitle"
            tools:text="Salesforce Mobile" />

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.KeyNest.Meta"
            tools:text="k.tanaka@company.co.jp" />

        <!--
            Package name on its own row in monospace (AC 4.3.1 / 4.2.2).
            TextAppearance.KeyNest.Mono already declares
            android:fontFamily="monospace", textSize 12sp, and
            textColor=@color/kn_text_3. We override the size to 11sp to
            match the spec's "11sp / 500 / text-3" caption requirement.
        -->
        <TextView
            android:id="@+id/text_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.KeyNest.Mono"
            android:textSize="11sp"
            tools:text="com.salesforce.chatter" />
    </LinearLayout>

</LinearLayout>
