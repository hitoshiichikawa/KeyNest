<?xml version="1.0" encoding="utf-8"?>
<!--
  Issue #9: Row layout adds a trailing ImageButton (︙) as the entry point
  for the per-row overflow menu (Req 5.1 / 5.2). The button has a 48dp
  minimum size for the accessibility touch target (NFR 3.2).

  Password is intentionally NEVER bound into any view here (NFR 1.3).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_overflow"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/credential_list_row_overflow_a11y"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_more" />

</LinearLayout>
