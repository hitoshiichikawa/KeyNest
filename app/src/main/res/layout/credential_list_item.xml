<?xml version="1.0" encoding="utf-8"?>
<!--
  Issue #29: credential list row card.

  Source of truth:
  - JSX: design/screens/screens-1.jsx > CredCard.
  - Token mapping: design/android-assets/mapping.md §6 (Credential card).

  Visual contract (mapping cited per Req):
  - Card outline (Req 5.1): Widget.KeyNest.Card → kn_surface + 1dp
    kn_border + r_card (18dp).
  - Card inner padding (Req 5.2): kn_card_padding (14dp).
  - Icon tile (Req 5.3 / 5.4): 44dp square, 12dp radius (kn_r_sm),
    kn_blue_500 fallback fill (kn_icon_tile_bg drawable).
  - Title text (Req 5.5): Text.KeyNest.Body, single-line ellipsis.
  - Username text (Req 5.6): Text.KeyNest.BodyS, kn_text_2, single-line
    ellipsis.
  - Package text (Req 5.7): Text.KeyNest.Mono (JetBrains Mono / 12sp),
    kn_text_3, single-line ellipsis.
  - StrengthBar (Req 6.x): custom view defined in
    com.example.keynest.ui.widget.StrengthBar. Hidden by default (the
    Credential domain has no strength field — Req 6.5).
  - Signature chip (Req 7.x): visibility + tint set by the adapter from
    Credential.signatureSha256.
  - Per-row overflow (Req 5.8 / Req 9.x): 48dp tap target, 24dp icon,
    kn_text_3 tint.

  IDs preserved from Issue #9 / Req 10.1: text_label / text_subtitle /
  btn_overflow.

  NFR 1.3: password / ciphertext is intentionally NEVER bound here.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.KeyNest.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/kn_space_2"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/kn_card_padding"
        android:paddingVertical="@dimen/kn_card_padding">

        <!-- Icon tile (Req 5.3 / 5.4). 44dp / r12 / kn_blue_500.
             A 1-letter TextView could go inside in a follow-up Issue
             that adds per-credential letters; for #29 we render the
             tile only. -->
        <FrameLayout
            android:layout_width="@dimen/kn_icon_tile_lg"
            android:layout_height="@dimen/kn_icon_tile_lg"
            android:layout_marginEnd="@dimen/kn_space_3"
            android:background="@drawable/kn_icon_tile_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title row: label + signature chip (Req 5.5 + Req 7.x).
                 LinearLayout sizes the chip to wrap, label takes the rest. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_label"
                    style="@style/Text.KeyNest.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Salesforce Mobile" />

                <!-- Signature chip (Req 7.x). The whole LinearLayout is
                     toggled by the adapter (visible iff signature is captured
                     to show "Signature OK", visible with warning bg to show
                     "Signature missing"). Background drawable + textColor are
                     swapped between kn_signature_chip_bg_success and
                     kn_signature_chip_bg_warning. -->
                <LinearLayout
                    android:id="@+id/chip_signature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/kn_space_2"
                    android:background="@drawable/kn_signature_chip_bg_success"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/kn_space_2"
                    android:paddingVertical="2dp">

                    <ImageView
                        android:id="@+id/icon_signature"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield_fill_16"
                        app:tint="@color/kn_success" />

                    <TextView
                        android:id="@+id/text_signature"
                        style="@style/Text.KeyNest.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/kn_success"
                        tools:text="@string/signature_match" />
                </LinearLayout>
            </LinearLayout>

            <!-- Username (Req 5.6) -->
            <TextView
                android:id="@+id/text_subtitle"
                style="@style/Text.KeyNest.BodyS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/kn_text_2"
                tools:text="k.tanaka@company.co.jp" />

            <!-- Strength bar + package row (Req 5.7 + Req 6.x).
                 The StrengthBar is hidden by default (Req 6.5). The
                 package label uses Text.KeyNest.Mono / kn_text_3. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kn_space_1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.example.keynest.ui.widget.StrengthBar
                    android:id="@+id/strength_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/kn_space_2" />

                <TextView
                    android:id="@+id/text_package"
                    style="@style/Text.KeyNest.Mono"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/kn_text_3"
                    tools:text="com.salesforce.chatter" />
            </LinearLayout>
        </LinearLayout>

        <!-- Per-row overflow (Req 5.8 / Req 9.x).
             48dp x 48dp tap target preserved from Issue #9.
             ID and content description kept identical so existing
             setOnClickListener wiring in CredentialListAdapter and
             TalkBack strings keep working (Req 10.1 / NFR 2.2). -->
        <ImageButton
            android:id="@+id/btn_overflow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/kn_space_2"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/credential_list_row_overflow_a11y"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert_24"
            app:tint="@color/kn_text_3" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
