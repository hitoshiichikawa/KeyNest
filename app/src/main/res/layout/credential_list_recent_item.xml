<?xml version="1.0" encoding="utf-8"?>
<!--
  Issue #29 Req 4.x: "Recently used" carousel card.

  Source of truth:
  - JSX: design/screens/screens-1.jsx > ScreenListPopulated > recent row.
    Each card is 132dp wide, padding 14dp, radius 18dp, background
    var surface, border 1dp var border.
    Inside: IconTile (36dp / r10), then label (13/700) + meta row with
    clock icon + relative time (11/500 var text-3).
  - Token mapping: design/android-assets/mapping.md §6.

  IDs preserved from Issue #9: card_recent / text_recent_label /
  text_recent_username (Req 10.1). The "username" view is repurposed as
  the meta sub-label per the JSX — it shows the username, not a recent
  timestamp, because the existing RecentlyUsedCarouselAdapter binds
  username text there. A future Issue can swap it to a relative-time
  label once the adapter has access to lastUsedAt.

  NFR 1.3: password / ciphertext is intentionally NEVER bound here.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_recent"
    android:layout_width="132dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/kn_space_3"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="48dp"
    app:cardBackgroundColor="@color/kn_surface"
    app:cardCornerRadius="@dimen/kn_r_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/kn_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/kn_card_padding">

        <!-- Icon tile (Req 4.3 / 4.4): 36dp / r12 (kn_r_sm) / kn_blue_500.
             Issue #43: the inner ImageView (id=icon_app) is painted by
             IconLoader.loadInto with the real app icon or the
             initial-letter fallback. The kn_icon_tile_bg behind it stays
             visible while the loader is resolving (Req 3.1). -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="@dimen/kn_space_2"
            android:background="@drawable/kn_icon_tile_bg">

            <ImageView
                android:id="@+id/icon_app"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <!-- Label (Req 4.5: Body, 14sp / weight 600). -->
        <TextView
            android:id="@+id/text_recent_label"
            style="@style/Text.KeyNest.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Salesforce Mobile" />

        <!-- Meta sub-label (Req 4.5: Caption 12sp / weight 500).
             Adapter writes the username into this field today; per Req
             10.1 we keep both the id and the text source unchanged. -->
        <TextView
            android:id="@+id/text_recent_username"
            style="@style/Text.KeyNest.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/kn_text_3"
            tools:text="k.tanaka" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
