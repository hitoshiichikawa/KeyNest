<?xml version="1.0" encoding="utf-8"?>
<!--
  OSS license list row. Issue #10 Req 5.2 / 5.3 + Issue #33 Req 10 (KeyNest
  カード仕様への整合).

  Issue #33 で置換した点:
    - card style を Widget.Material3.CardView.Outlined から Widget.KeyNest.Card
      (kn_surface + kn_border 1dp + kn_r_card 18dp) に切替 (Req 10.1).
    - text_name TextAppearance を ?attr/textAppearanceTitleSmall から
      Text.KeyNest.TitleS に切替 (Req 10.2).
    - text_license / text_body TextAppearance を ?attr/textAppearanceBodySmall
      から Text.KeyNest.BodyS / Text.KeyNest.Caption に置換し、textColor を
      明示的に kn_text_2 にバインド (Req 10.3).
    - btn_url を Widget.Material3.Button.TextButton から Widget.KeyNest.Button.Text
      (kn_primary 文字色) に切替 (Req 10.4).

  既存 View ID (text_name / text_license / btn_url / text_body) は保持
  (Req 10.5). 既存の Adapter ロジック (展開トグル / ACTION_VIEW dispatch) は
  変更しない (Req 10.6).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.KeyNest.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/kn_screen_padding_h"
    android:layout_marginVertical="@dimen/kn_space_1"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:padding="@dimen/kn_card_padding">

        <TextView
            android:id="@+id/text_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.KeyNest.TitleS"
            android:textColor="@color/kn_text"
            tools:text="Library name" />

        <TextView
            android:id="@+id/text_license"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kn_space_1"
            android:textAppearance="@style/Text.KeyNest.BodyS"
            android:textColor="@color/kn_text_2"
            tools:text="Apache 2.0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_url"
            style="@style/Widget.KeyNest.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kn_space_1"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:contentDescription="@string/oss_licenses_url_a11y"
            android:text="@string/oss_licenses_url_a11y"
            android:textColor="@color/kn_primary"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/text_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kn_space_2"
            android:textAppearance="@style/Text.KeyNest.Caption"
            android:textColor="@color/kn_text_2"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="License full text…" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
