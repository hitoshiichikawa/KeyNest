<?xml version="1.0" encoding="utf-8"?>
<!--
  Issue #32 Req 4.9: empty-state row for PackagePickerBottomSheet.

  Shown when the active search filter produces zero matches in the
  "すべてのアプリ" section. (Issue #48 removed the SAMPLE "業務でよく使う"
  section, so only the All-apps list is filtered now.) The manual-entry
  row is always rendered separately at the sheet bottom, so the user
  still has a fallback path in this state.

  Visual: centered single-line message using Text.KeyNest.BodyS / kn_text_3
  to match the muted look of the section headers but with normal letter
  spacing (no uppercase).
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/text_empty"
    style="@style/Text.KeyNest.BodyS"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:paddingHorizontal="@dimen/kn_space_3"
    android:paddingVertical="@dimen/kn_space_6"
    android:text="@string/package_picker_no_results"
    android:textColor="@color/kn_text_3"
    tools:ignore="UnusedAttribute" />
