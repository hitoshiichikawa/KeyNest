<?xml version="1.0" encoding="utf-8"?>
<!--
    Row inside the package picker bottom sheet — mirrors
    `design/screens/screens-2.jsx` <PickerRow/>:
      - 40dp IconTile with the app's first letter
      - app name (14sp/700)
      - monospace package name (11sp/500 text-3)

    AC 4.5.3 / 4.5.4
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/kn_target_min"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/kn_space_3"
    android:paddingVertical="@dimen/kn_space_2">

    <FrameLayout
        android:layout_width="@dimen/kn_icontile_md"
        android:layout_height="@dimen/kn_icontile_md"
        android:background="@drawable/bg_icon_tile_primary">

        <TextView
            android:id="@+id/icon_letter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/kn_on_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="S" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/kn_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.KeyNest.CardTitle"
            android:textSize="14sp"
            tools:text="Salesforce Mobile" />

        <TextView
            android:id="@+id/package_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.KeyNest.Mono"
            android:textSize="11sp"
            tools:text="com.salesforce.chatter" />
    </LinearLayout>

</LinearLayout>
