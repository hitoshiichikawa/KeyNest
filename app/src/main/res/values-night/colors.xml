<?xml version="1.0" encoding="utf-8"?>
<!--
    KeyNest design tokens (Dark).

    Mapped 1:1 from `design/tokens.css` (.kn-dark section). Only the
    semantic-role aliases differ from Light; raw palette entries
    (kn_blue_500 etc.) stay constant so any tooling that references the
    brand palette keeps working.

    NFR 2.1 / Requirements: 4.1.2, 4.1.6
-->
<resources>

    <!-- ── Semantic roles (Dark) ── -->
    <color name="kn_bg">@color/kn_ink_950</color>
    <color name="kn_bg_elev">@color/kn_ink_900</color>
    <color name="kn_surface">@color/kn_ink_850</color>
    <color name="kn_surface_2">@color/kn_ink_800</color>
    <!-- surface-tint dark = primary @ 16% -->
    <color name="kn_surface_tint">#291F6FEB</color>
    <!-- 0x0F / 0x1F = ~6% / ~12% white -->
    <color name="kn_border">#0FFFFFFF</color>
    <color name="kn_border_strong">#1FFFFFFF</color>
    <color name="kn_text_primary">#ECF1FA</color>
    <color name="kn_text_2">@color/kn_ink_300</color>
    <color name="kn_text_3">@color/kn_ink_400</color>
    <color name="kn_on_primary">#FFFFFF</color>
    <!-- Dark uses a softer primary so it stays accessible on deep navy -->
    <color name="kn_primary">#4D8DF4</color>
    <color name="kn_primary_hover">@color/kn_blue_300</color>

    <!-- Status colors stay constant across themes for instant recognition.
         They're declared inherited from values/colors.xml automatically. -->

    <!-- Legacy aliases -->
    <color name="keynest_primary">@color/kn_primary</color>
    <color name="keynest_primary_variant">@color/kn_primary_hover</color>
</resources>
