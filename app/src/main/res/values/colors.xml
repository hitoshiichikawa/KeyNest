<?xml version="1.0" encoding="utf-8"?>
<!--
  KeyNest — Light theme palette.
  Source of truth: design/tokens.css.
  Naming: kn_<role>_<step>. Dark overrides live in values-night/colors.xml.
  Place at: app/src/main/res/values/colors.xml (REPLACES the 3-color stub).
-->
<resources>

    <!-- ── Brand · Blue ──────────────────────────────── -->
    <color name="kn_blue_50">#EAF2FE</color>
    <color name="kn_blue_100">#D0E0FC</color>
    <color name="kn_blue_200">#A6C4F8</color>
    <color name="kn_blue_300">#6FA1F2</color>
    <color name="kn_blue_500">#1F6FEB</color>  <!-- primary -->
    <color name="kn_blue_600">#1457C9</color>
    <color name="kn_blue_700">#0F4AA8</color>
    <color name="kn_blue_900">#0A2E66</color>

    <!-- ── Accent · Indigo ───────────────────────────── -->
    <color name="kn_accent_500">#6366F1</color>
    <color name="kn_accent_600">#4F46E5</color>

    <!-- ── Ink (neutral) ─────────────────────────────── -->
    <color name="kn_ink_950">#0A1020</color>
    <color name="kn_ink_900">#0F1729</color>
    <color name="kn_ink_850">#131C33</color>
    <color name="kn_ink_800">#1A2540</color>
    <color name="kn_ink_750">#243054</color>
    <color name="kn_ink_700">#2E3B62</color>
    <color name="kn_ink_500">#5C6B8E</color>
    <color name="kn_ink_400">#7A89AD</color>
    <color name="kn_ink_300">#9CA9C7</color>
    <color name="kn_ink_200">#C6CFE0</color>
    <color name="kn_ink_100">#E3E8F1</color>
    <color name="kn_ink_50">#F1F4FA</color>
    <color name="kn_paper">#F6F8FC</color>
    <color name="kn_white">#FFFFFF</color>

    <!-- ── Status ────────────────────────────────────── -->
    <color name="kn_success">#10B981</color>
    <color name="kn_success_soft">#D1FAE5</color>
    <color name="kn_warning">#F59E0B</color>
    <color name="kn_warning_soft">#FEF3C7</color>
    <color name="kn_danger">#EF4444</color>
    <color name="kn_danger_soft">#FEE2E2</color>
    <color name="kn_info">#38BDF8</color>

    <!-- ── Brand icon background (adaptive icon) ─────── -->
    <color name="kn_brand_cream">#F4EBDC</color>
    <color name="kn_brand_cream_2">#D9C3A0</color>
    <color name="kn_brand_twig">#9B7A4A</color>

    <!-- ──────────────────────────────────────────────── -->
    <!-- ── Semantic tokens — LIGHT.                    ── -->
    <!-- ── Code/layout/themes.xml MUST reference these ── -->
    <!-- ── (not the raw palette above). values-night/  ── -->
    <!-- ── overrides redefine the same names.          ── -->
    <!-- ──────────────────────────────────────────────── -->

    <color name="kn_bg">@color/kn_paper</color>
    <color name="kn_bg_elev">@color/kn_white</color>
    <color name="kn_surface">@color/kn_white</color>
    <color name="kn_surface_2">@color/kn_ink_50</color>
    <color name="kn_surface_tint">@color/kn_blue_50</color>

    <color name="kn_border">#14000000</color>          <!-- rgba(15,23,41,.08) ≈ ink @ 8% -->
    <color name="kn_border_strong">#24000000</color>   <!-- rgba(15,23,41,.14) ≈ ink @ 14% -->

    <color name="kn_text">#0B1220</color>
    <color name="kn_text_2">@color/kn_ink_500</color>
    <color name="kn_text_3">@color/kn_ink_400</color>

    <color name="kn_primary">@color/kn_blue_500</color>
    <color name="kn_primary_hover">@color/kn_blue_600</color>
    <color name="kn_on_primary">@color/kn_white</color>
    <color name="kn_primary_container">@color/kn_blue_50</color>
    <color name="kn_on_primary_container">@color/kn_blue_900</color>

    <color name="kn_secondary">@color/kn_accent_500</color>
    <color name="kn_on_secondary">@color/kn_white</color>

    <!-- ── Aliases the existing code already references ── -->
    <color name="keynest_primary">@color/kn_blue_500</color>
    <color name="keynest_primary_variant">@color/kn_blue_600</color>
    <color name="keynest_secondary">@color/kn_accent_500</color>

    <!-- Issue #33 Req 2.12: 半透明白 ripple color (Autofill hero CTA 用).
         hero gradient (kn_primary to kn_blue_700) 上で白ボタンを押した時の
         feedback ripple. Light / Dark で同一の rgba(255,255,255,0.2)
         (= #33FFFFFF) を使う. hero gradient 自体が両モードでブルー系を
         保つため、ripple alpha も共有でよい. -->
    <color name="kn_hero_ripple_on_primary">#33FFFFFF</color>

</resources>
