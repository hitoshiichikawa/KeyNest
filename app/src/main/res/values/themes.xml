<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KeyNest" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/keynest_primary</item>
        <item name="colorPrimaryVariant">@color/keynest_primary_variant</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/keynest_secondary</item>
        <!--
            Use the Material surface color (respects DayNight) so text colored
            with textColorPrimary remains readable in both modes. Hard-pinning
            windowBackground to white caused white-on-white text in dark mode.
        -->
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <style name="Theme.KeyNest.Translucent" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
