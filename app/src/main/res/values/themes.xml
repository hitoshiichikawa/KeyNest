<?xml version="1.0" encoding="utf-8"?>
<!--
  KeyNest — Material3 theme wiring.
  Sourced from design/android-assets/res/values/themes.xml (Issue #28
  Phase 1 取り込み) but restructured to retain the exact structure that
  Issue #24 / Issue #13 の Material3ThemeMigrationTest と
  FontTypefaceWiringTest が verify する不変条件 (Req 5.2):

    * Theme.KeyNest が Theme.Material3.DayNight.NoActionBar を直接親に持つ
      (中間 Base スタイルを介さない).
    * 13 個の M3 textAppearance attribute slot
      (textAppearanceDisplayLarge ... textAppearanceLabelSmall) が
      Theme.KeyNest 内に明示列挙され、それぞれ
      TextAppearance.KeyNest.Headline1..Overline (M3 親) を指す.
    * 13 個の TextAppearance.KeyNest.* スタイルが
      TextAppearance.Material3.* を親とし、@font/manrope override を
      android: と app: の両 namespace に保持する.
    * Theme.KeyNest 自身が android:fontFamily / fontFamily を
      @font/manrope で override している (素の TextView や EditText hint
      を含む全 view が Manrope を引くため).
    * Theme.KeyNest.Translucent は Material 2 親のままで保持
      (AutofillUnlockActivity の透過テーマ. NFR 3.2 / Req 5.3).

  Phase 1 取り込みで追加される design token bridge:

    * colorPrimary / colorOnPrimary / colorSurface 等の Material3
      colorScheme を kn_* セマンティック色にマップ (Req 1.4 / Req 2.x).
      values-night/colors.xml が semantic を再定義する形で dark mode の
      上書きが有効になる.
    * shapeAppearanceCorner* を ShapeAppearance.KeyNest.* に橋渡しし、
      共有 dimens (kn_r_xs..xl) を corner radius のソースに使う.
    * Widget.KeyNest.Button.Primary / Card / TextField / Chip /
      BottomSheet / ShapeAppearance.KeyNest.Sheet を design 側そのまま
      持ち込む. これらは Phase 2 layout から style="@style/..." で参照する
      用. 現時点の既存 layout は直接参照していない.
    * dynamicColorThemeOverlay=@null で Material You を OFF
      (Out of Scope に従い design 側カラーを単一情報源にする).
    * 追加 Material3 type-scale slot
      (textAppearanceTitleLarge / textAppearanceLabelMedium) を
      Text.KeyNest.* の新 11 ロールに橋渡し (Req 1.3).

  M2 / M3 type-scale 対応 (Issue #24 Req 2.5):
    Headline1 -> DisplayLarge,    Headline2 -> DisplayMedium,
    Headline3 -> DisplaySmall,    Headline4 -> HeadlineLarge,
    Headline5 -> HeadlineMedium,  Headline6 -> HeadlineSmall,
    Subtitle1 -> TitleMedium,     Subtitle2 -> TitleSmall,
    Body1     -> BodyLarge,       Body2     -> BodyMedium,
    Button    -> LabelLarge,      Caption   -> BodySmall,
    Overline  -> LabelSmall.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Issue #13 / Issue #24 互換: 13 個の TextAppearance.KeyNest.*
        スタイル. 各スタイルは M3 親を継承しつつ Manrope を強制する.
        Issue #24 の Material3ThemeMigrationTest が style 名 / 親 /
        @font/manrope override を厳密に検証する.
    -->
    <style name="TextAppearance.KeyNest.Headline1"
        parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="TextAppearance.KeyNest.Headline2"
        parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="TextAppearance.KeyNest.Headline3"
        parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="TextAppearance.KeyNest.Headline4"
        parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="TextAppearance.KeyNest.Headline5"
        parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="TextAppearance.KeyNest.Headline6"
        parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="TextAppearance.KeyNest.Subtitle1"
        parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="TextAppearance.KeyNest.Subtitle2"
        parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="TextAppearance.KeyNest.Body1"
        parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="TextAppearance.KeyNest.Body2"
        parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="TextAppearance.KeyNest.Button"
        parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="TextAppearance.KeyNest.Caption"
        parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="TextAppearance.KeyNest.Overline"
        parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <!--
        Theme.KeyNest 本体. Issue #24 の Material3ThemeMigrationTest が
        次を厳密に verify する:
          * parent="Theme.Material3.DayNight.NoActionBar" (中間 Base 不可).
          * 13 個の M3 textAppearance attribute slot がすべて宣言され、
            TextAppearance.KeyNest.Headline1..Overline を指す.
          * android:fontFamily / fontFamily が @font/manrope.
          * M2 の slot 名 (textAppearanceHeadline1 等) を redeclare しない.
        ここに Issue #28 Phase 1 の design token bridge を追加注入する形で
        構造的後方互換を維持する.
    -->
    <style name="Theme.KeyNest" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- ── Color scheme (Issue #28 Phase 1) ────────── -->
        <item name="colorPrimary">@color/kn_primary</item>
        <item name="colorOnPrimary">@color/kn_on_primary</item>
        <item name="colorPrimaryContainer">@color/kn_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/kn_on_primary_container</item>

        <item name="colorSecondary">@color/kn_secondary</item>
        <item name="colorOnSecondary">@color/kn_on_secondary</item>
        <item name="colorSecondaryContainer">@color/kn_surface_tint</item>
        <item name="colorOnSecondaryContainer">@color/kn_primary</item>

        <item name="android:colorBackground">@color/kn_bg</item>
        <item name="colorOnBackground">@color/kn_text</item>
        <item name="colorSurface">@color/kn_surface</item>
        <item name="colorOnSurface">@color/kn_text</item>
        <item name="colorSurfaceVariant">@color/kn_surface_2</item>
        <item name="colorOnSurfaceVariant">@color/kn_text_2</item>
        <item name="colorSurfaceContainer">@color/kn_surface</item>
        <item name="colorSurfaceContainerLow">@color/kn_bg</item>
        <item name="colorSurfaceContainerHigh">@color/kn_bg_elev</item>
        <item name="colorOutline">@color/kn_border_strong</item>
        <item name="colorOutlineVariant">@color/kn_border</item>

        <item name="colorError">@color/kn_danger</item>
        <item name="colorErrorContainer">@color/kn_danger_soft</item>
        <item name="colorOnError">@color/kn_white</item>

        <!-- Material You OFF: design 側 palette を単一情報源にする. -->
        <item name="dynamicColorThemeOverlay">@null</item>

        <!-- ── Shape (Issue #28 Phase 1) ───────────────── -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.KeyNest.XS</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.KeyNest.SM</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.KeyNest.MD</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.KeyNest.LG</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.KeyNest.XL</item>

        <!-- ── Background fallback for non-M3 widgets ───── -->
        <!--
            Issue #24 までの実装では android:windowBackground を
            ?attr/colorSurface に固定していたが、Phase 1 取り込み後は
            colorBackground (kn_bg) と colorSurface (kn_surface) が
            light/dark 両方で定義されているため、widgetBackground は
            colorSurface に解決されたまま安全 (差分は paper / white の
            濃淡だけ).
        -->
        <item name="android:windowBackground">?attr/colorSurface</item>

        <!--
            Issue #24 が要求する 13 個の M3 textAppearance slot. Phase 1
            では Material3ThemeMigrationTest / FontTypefaceWiringTest との
            互換性を保つため、次の slot を必ず TextAppearance.KeyNest.* に
            橋渡しする:
        -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.KeyNest.Headline1</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.KeyNest.Headline2</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.KeyNest.Headline3</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.KeyNest.Headline4</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.KeyNest.Headline5</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.KeyNest.Headline6</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.KeyNest.Subtitle1</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.KeyNest.Subtitle2</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.KeyNest.Body1</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.KeyNest.Body2</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.KeyNest.Button</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.KeyNest.Caption</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.KeyNest.Overline</item>

        <!--
            Issue #13: theme-level Manrope override. textAppearance を
            指定しない素の TextView / EditText hint も Manrope を引くため
            に必要 (FontTypefaceWiringTest が直接これを verify する).
        -->
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>

        <!-- ── System bars (Issue #128) ────────────────── -->
        <!--
            Android 15 (API 35) で android:statusBarColor /
            android:navigationBarColor / windowLightStatusBar /
            windowLightNavigationBar が非推奨化したため撤去.
            edge-to-edge と icon appearance は Activity.onCreate で
            enableEdgeToEdgeWithKnDefaults() (util/EdgeToEdgeInsets.kt)
            を呼んで WindowInsetsControllerCompat 経由で設定する.
        -->
    </style>

    <!--
        Issue #24 Out of Scope: Theme.KeyNest.Translucent parent is left on
        Theme.MaterialComponents.DayNight.NoActionBar because (a) it is only
        used by AutofillUnlockActivity which displays a BiometricPrompt on
        top of an otherwise transparent window and never inflates any of
        the M3 widgets that triggered the crash on Theme.KeyNest, and
        (b) Req 3.5 only mandates that its transparent-launch behaviour be
        preserved across this fix.

        Issue #28 Phase 1: design 側 themes.xml は本テーマを含まないため、
        既存実装をそのまま再掲して動作を保持する (NFR 3.2 / Req 5.3).
    -->
    <style name="Theme.KeyNest.Translucent" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!--
        Issue #28 Phase 1: ShapeAppearance.KeyNest.* — Material3 corner
        family を design tokens (kn_r_*) に橋渡し.
    -->
    <style name="ShapeAppearance.KeyNest.XS" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">@dimen/kn_r_xs</item>
    </style>
    <style name="ShapeAppearance.KeyNest.SM" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/kn_r_sm</item>
    </style>
    <style name="ShapeAppearance.KeyNest.MD" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/kn_r_md</item>
    </style>
    <style name="ShapeAppearance.KeyNest.LG" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/kn_r_lg</item>
    </style>
    <style name="ShapeAppearance.KeyNest.XL" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/kn_r_xl</item>
    </style>

    <!--
        Issue #28 Phase 1: 再利用可能な Widget スタイル. 現時点の layout は
        参照していない. Phase 2 の各画面 PR で style="@style/Widget.KeyNest.X"
        を貼ることでデザインに揃える前提.
    -->
    <style name="Widget.KeyNest.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/Text.KeyNest.LabelL</item>
        <item name="android:minHeight">@dimen/kn_button_height</item>
        <item name="cornerRadius">@dimen/kn_r_md</item>
        <item name="android:paddingStart">@dimen/kn_space_6</item>
        <item name="android:paddingEnd">@dimen/kn_space_6</item>
    </style>

    <style name="Widget.KeyNest.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/Text.KeyNest.LabelL</item>
        <item name="android:textColor">@color/kn_primary</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <!--
        Issue #30 Req 8.5 / 8.6 / 8.7: destructive CTA used at the bottom of
        the CredentialEdit screen in edit mode (削除).

        Visual contract (JSX `ScreenEdit` の削除ボタン):
          - background: 透過 (background transparent)
          - border: 1dp CSS var border outline → strokeColor=@color/kn_border
          - radius: 14dp (borderRadius 14) → @dimen/kn_r_input
          - text color: CSS var kn danger → @color/kn_danger
          - height: 52dp (@dimen/kn_button_height)
          - text appearance: LabelL (15sp / weight 700)

        OutlinedButton 親を採用したのは:
          (a) strokeColor / strokeWidth / cornerRadius の M3 attribute
              が直接効くため layout 側で属性を増やさない
          (b) ripple / state list の最低限の挙動 (押下時のフィードバック) を
              ベースのまま受け取れるため. 押下時の色変化は kn_danger 同系で
              colorPrimary を override せずとも視覚的に許容範囲.
    -->
    <style name="Widget.KeyNest.Button.Destructive" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/Text.KeyNest.LabelL</item>
        <item name="android:textColor">@color/kn_danger</item>
        <item name="android:minHeight">@dimen/kn_button_height</item>
        <item name="cornerRadius">@dimen/kn_r_input</item>
        <item name="strokeColor">@color/kn_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/kn_danger_soft</item>
    </style>

    <style name="Widget.KeyNest.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/kn_r_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/kn_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/kn_surface</item>
        <item name="contentPadding">@dimen/kn_card_padding</item>
    </style>

    <style name="Widget.KeyNest.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/kn_r_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/kn_r_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/kn_r_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/kn_r_input</item>
        <item name="boxStrokeColor">@color/kn_primary</item>
        <item name="hintTextColor">@color/kn_text_2</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="Widget.KeyNest.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/kn_r_chip</item>
        <item name="chipMinHeight">@dimen/kn_chip_height</item>
        <item name="android:textAppearance">@style/Text.KeyNest.Caption</item>
    </style>

    <style name="Widget.KeyNest.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.KeyNest.Sheet</item>
    </style>
    <style name="ShapeAppearance.KeyNest.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/kn_r_sheet</item>
        <item name="cornerSizeTopRight">@dimen/kn_r_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!--
        Issue #31 Phase 2 (Onboarding) — small row / chip style helpers
        used by autofill_enable_activity.xml. These keep the per-step
        layout XML short and pin the JSX visual contract in one place.
    -->
    <style name="Widget.KeyNest.OnboardingStepRow" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Widget.KeyNest.OnboardingStepChip" parent="">
        <item name="android:background">@drawable/kn_onboarding_step_chip_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/kn_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/manrope</item>
    </style>

</resources>
