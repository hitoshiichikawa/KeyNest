<?xml version="1.0" encoding="utf-8"?>
<!--
  KeyNest — TextAppearance roles.
  Each role mirrors design/spec.md §4. Manrope for Latin, Noto Sans JP
  fallback for 日本語 (declared via @font/manrope_family that lists both).
  JetBrains Mono is used in code for password/mono fields directly.
  Place at: app/src/main/res/values/type.xml (new file)
-->
<resources>

    <!-- Display (Onboarding hero, empty-state) — 28sp / 800 / -0.02em -->
    <style name="Text.KeyNest.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/manrope_family</item>
        <item name="fontFamily">@font/manrope_family</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="p" xmlns:tools="http://schemas.android.com/tools">800</item>
        <item name="android:textSize">28sp</item>
        <item name="android:lineHeight">34sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/kn_text</item>
    </style>

    <!-- App bar large title ("Vault") — 26sp / 800 -->
    <style name="Text.KeyNest.TitleL" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/manrope_family</item>
        <item name="fontFamily">@font/manrope_family</item>
        <item name="android:textFontWeight" tools:targetApi="p" xmlns:tools="http://schemas.android.com/tools">800</item>
        <item name="android:textSize">26sp</item>
        <item name="android:lineHeight">30sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/kn_text</item>
    </style>

    <!-- Sheet / modal title — 19sp / 800 -->
    <style name="Text.KeyNest.TitleM" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/manrope_family</item>
        <item name="fontFamily">@font/manrope_family</item>
        <item name="android:textFontWeight" tools:targetApi="p" xmlns:tools="http://schemas.android.com/tools">800</item>
        <item name="android:textSize">19sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/kn_text</item>
    </style>

    <!-- App bar small / screen sub-heading — 16sp / 700 -->
    <style name="Text.KeyNest.TitleS" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/manrope_family</item>
        <item name="fontFamily">@font/manrope_family</item>
        <item name="android:textFontWeight" tools:targetApi="p" xmlns:tools="http://schemas.android.com/tools">700</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">22sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/kn_text</item>
    </style>

    <!-- Card primary text — 14sp / 600 -->
    <style name="Text.KeyNest.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/manrope_family</item>
        <item name="fontFamily">@font/manrope_family</item>
        <item name="android:textFontWeight" tools:targetApi="p" xmlns:tools="http://schemas.android.com/tools">600</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:textColor">@color/kn_text</item>
    </style>

    <!-- List subtitle / sub-text — 13sp / 500 -->
    <style name="Text.KeyNest.BodyS" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/manrope_family</item>
        <item name="fontFamily">@font/manrope_family</item>
        <item name="android:textFontWeight" tools:targetApi="p" xmlns:tools="http://schemas.android.com/tools">500</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineHeight">18sp</item>
        <item name="android:textColor">@color/kn_text_2</item>
    </style>

    <!-- Helper / meta — 12sp / 500 -->
    <style name="Text.KeyNest.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/manrope_family</item>
        <item name="fontFamily">@font/manrope_family</item>
        <item name="android:textFontWeight" tools:targetApi="p" xmlns:tools="http://schemas.android.com/tools">500</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:textColor">@color/kn_text_2</item>
    </style>

    <!-- Section eyebrow — 11sp / 700 / 0.08em uppercase -->
    <style name="Text.KeyNest.Eyebrow" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/manrope_family</item>
        <item name="fontFamily">@font/manrope_family</item>
        <item name="android:textFontWeight" tools:targetApi="p" xmlns:tools="http://schemas.android.com/tools">700</item>
        <item name="android:textSize">11sp</item>
        <item name="android:lineHeight">14sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/kn_text_3</item>
    </style>

    <!-- Button label — 15sp / 700 -->
    <style name="Text.KeyNest.LabelL" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/manrope_family</item>
        <item name="fontFamily">@font/manrope_family</item>
        <item name="android:textFontWeight" tools:targetApi="p" xmlns:tools="http://schemas.android.com/tools">700</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <!-- Mono — package name / SHA-256 — 12sp / 500 -->
    <style name="Text.KeyNest.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight">18sp</item>
        <item name="android:textColor">@color/kn_text_2</item>
    </style>

    <!-- Password input masked — 17sp / 700 / 0.1em mono -->
    <style name="Text.KeyNest.Password" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/kn_text</item>
    </style>

</resources>
