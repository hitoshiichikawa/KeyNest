<?xml version="1.0" encoding="utf-8"?>
<!--
    allowBackup="false" already disables auto backup. This file exists to satisfy
    the dataExtractionRules attribute (required since API 31 for explicitness) and
    documents that NO data (including device transfer) should be exported.
    NFR 1.1 / 1.2 / 1.5: encrypted credentials must not leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
