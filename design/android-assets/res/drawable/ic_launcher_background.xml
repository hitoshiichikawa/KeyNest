<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background — Icon B (Filled K-Key).
  108dp x 108dp canvas. Brand blue gradient.
  Place at: app/src/main/res/drawable/ic_launcher_background.xml
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="0" android:endY="108">
                <item android:offset="0" android:color="#FF2E80F8"/>
                <item android:offset="1" android:color="#FF0F4AA8"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
