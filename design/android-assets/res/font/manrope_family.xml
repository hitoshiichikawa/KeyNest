<?xml version="1.0" encoding="utf-8"?>
<!--
  Manrope — downloadable Google Font family. Falls back to Noto Sans JP
  for CJK glyphs.
  Place at: app/src/main/res/font/manrope_family.xml
  Requires: gms:strings/com_google_android_gms_fonts_certs.xml certificate
  resource (see provider_certs.xml in this folder).
  Add to build.gradle.kts deps: implementation("androidx.core:core-ktx:1.13+")
-->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        app:font="@font/manrope_regular"
        app:fontStyle="normal"
        app:fontWeight="500"/>
    <font
        app:font="@font/manrope_semibold"
        app:fontStyle="normal"
        app:fontWeight="600"/>
    <font
        app:font="@font/manrope_bold"
        app:fontStyle="normal"
        app:fontWeight="700"/>
    <font
        app:font="@font/manrope_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800"/>
</font-family>
