<?xml version="1.0" encoding="utf-8"?>
<!--
  KeyNest — Dark theme overrides.
  Only the SEMANTIC layer is redefined; the raw palette in values/colors.xml
  is shared with light. Status colors stay the same hex but the *_soft
  variants get reduced alpha so they don't blow out on dark surfaces.
  Place at: app/src/main/res/values-night/colors.xml
-->
<resources>

    <!-- Surfaces -->
    <color name="kn_bg">@color/kn_ink_950</color>
    <color name="kn_bg_elev">@color/kn_ink_900</color>
    <color name="kn_surface">@color/kn_ink_850</color>
    <color name="kn_surface_2">@color/kn_ink_800</color>
    <color name="kn_surface_tint">#291F6FEB</color>     <!-- rgba(31,111,235,.16) -->

    <!-- Borders -->
    <color name="kn_border">#0FFFFFFF</color>           <!-- rgba(255,255,255,.06) -->
    <color name="kn_border_strong">#1FFFFFFF</color>    <!-- rgba(255,255,255,.12) -->

    <!-- Text -->
    <color name="kn_text">#ECF1FA</color>
    <color name="kn_text_2">@color/kn_ink_300</color>
    <color name="kn_text_3">@color/kn_ink_400</color>

    <!-- Brand — lift the primary so contrast on dark is comfortable -->
    <color name="kn_primary">#4D8DF4</color>
    <color name="kn_primary_hover">#6FA1F2</color>
    <color name="kn_on_primary">@color/kn_white</color>
    <color name="kn_primary_container">#1A2D5C</color>
    <color name="kn_on_primary_container">@color/kn_blue_100</color>

    <!-- Status soft fills — dim on dark -->
    <color name="kn_success_soft">#1F10B981</color>
    <color name="kn_warning_soft">#1FF59E0B</color>
    <color name="kn_danger_soft">#1FEF4444</color>

    <!-- Aliases -->
    <color name="keynest_primary">@color/kn_primary</color>
    <color name="keynest_primary_variant">@color/kn_blue_600</color>

</resources>
