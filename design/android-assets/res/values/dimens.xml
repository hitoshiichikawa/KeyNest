<?xml version="1.0" encoding="utf-8"?>
<!--
  KeyNest — Spacing & radii.
  Source: design/tokens.css. Layouts MUST reference these dimens
  rather than typing dp values inline.
  Place at: app/src/main/res/values/dimens.xml (new file)
-->
