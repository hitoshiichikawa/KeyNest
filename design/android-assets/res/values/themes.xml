<?xml version="1.0" encoding="utf-8"?>
<!--
  KeyNest — Material3 theme wiring.
  Every Material3 colorScheme attribute is mapped to a kn_* semantic
  color. Component widget shapes/typography reference dimens.xml +
  type.xml. Day/Night switches automatically via values-night/colors.xml.
  Place at: app/src/main/res/values/themes.xml (REPLACE existing).
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base theme -->
    <style name="Base.Theme.KeyNest" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- ── ColorScheme ─────────────────────────────── -->
        <item name="colorPrimary">@color/kn_primary</item>
        <item name="colorOnPrimary">@color/kn_on_primary</item>
        <item name="colorPrimaryContainer">@color/kn_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/kn_on_primary_container</item>

        <item name="colorSecondary">@color/kn_secondary</item>
        <item name="colorOnSecondary">@color/kn_on_secondary</item>
        <item name="colorSecondaryContainer">@color/kn_surface_tint</item>
        <item name="colorOnSecondaryContainer">@color/kn_primary</item>

        <item name="android:colorBackground">@color/kn_bg</item>
        <item name="colorOnBackground">@color/kn_text</item>
        <item name="colorSurface">@color/kn_surface</item>
        <item name="colorOnSurface">@color/kn_text</item>
        <item name="colorSurfaceVariant">@color/kn_surface_2</item>
        <item name="colorOnSurfaceVariant">@color/kn_text_2</item>
        <item name="colorSurfaceContainer">@color/kn_surface</item>
        <item name="colorSurfaceContainerLow">@color/kn_bg</item>
        <item name="colorSurfaceContainerHigh">@color/kn_bg_elev</item>
        <item name="colorOutline">@color/kn_border_strong</item>
        <item name="colorOutlineVariant">@color/kn_border</item>

        <item name="colorError">@color/kn_danger</item>
        <item name="colorErrorContainer">@color/kn_danger_soft</item>
        <item name="colorOnError">@color/kn_white</item>

        <!-- Dynamic color OFF — we own the palette -->
        <item name="dynamicColorThemeOverlay">@null</item>

        <!-- ── Shape ───────────────────────────────────── -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.KeyNest.XS</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.KeyNest.SM</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.KeyNest.MD</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.KeyNest.LG</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.KeyNest.XL</item>

        <!-- ── Typography ──────────────────────────────── -->
        <item name="textAppearanceDisplayLarge">@style/Text.KeyNest.Display</item>
        <item name="textAppearanceHeadlineLarge">@style/Text.KeyNest.TitleL</item>
        <item name="textAppearanceHeadlineMedium">@style/Text.KeyNest.TitleL</item>
        <item name="textAppearanceTitleLarge">@style/Text.KeyNest.TitleM</item>
        <item name="textAppearanceTitleMedium">@style/Text.KeyNest.TitleS</item>
        <item name="textAppearanceTitleSmall">@style/Text.KeyNest.TitleS</item>
        <item name="textAppearanceBodyLarge">@style/Text.KeyNest.Body</item>
        <item name="textAppearanceBodyMedium">@style/Text.KeyNest.BodyS</item>
        <item name="textAppearanceBodySmall">@style/Text.KeyNest.Caption</item>
        <item name="textAppearanceLabelLarge">@style/Text.KeyNest.LabelL</item>
        <item name="textAppearanceLabelMedium">@style/Text.KeyNest.Eyebrow</item>
        <item name="textAppearanceLabelSmall">@style/Text.KeyNest.Eyebrow</item>

        <!-- ── System bars ─────────────────────────────── -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/kn_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

    </style>

    <style name="Theme.KeyNest" parent="Base.Theme.KeyNest"/>

    <!-- ── Shape appearances ─────────────────────────── -->
    <style name="ShapeAppearance.KeyNest.XS" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">@dimen/kn_r_xs</item>
    </style>
    <style name="ShapeAppearance.KeyNest.SM" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/kn_r_sm</item>
    </style>
    <style name="ShapeAppearance.KeyNest.MD" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/kn_r_md</item>
    </style>
    <style name="ShapeAppearance.KeyNest.LG" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/kn_r_lg</item>
    </style>
    <style name="ShapeAppearance.KeyNest.XL" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/kn_r_xl</item>
    </style>

    <!-- ── Reusable widget overlays ──────────────────── -->

    <!-- Primary CTA — full width, 52dp, 16dp corners -->
    <style name="Widget.KeyNest.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/Text.KeyNest.LabelL</item>
        <item name="android:minHeight">@dimen/kn_button_height</item>
        <item name="cornerRadius">@dimen/kn_r_md</item>
        <item name="android:paddingStart">@dimen/kn_space_6</item>
        <item name="android:paddingEnd">@dimen/kn_space_6</item>
    </style>

    <style name="Widget.KeyNest.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/Text.KeyNest.LabelL</item>
        <item name="android:textColor">@color/kn_primary</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <!-- Credential card -->
    <style name="Widget.KeyNest.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/kn_r_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/kn_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/kn_surface</item>
        <item name="contentPadding">@dimen/kn_card_padding</item>
    </style>

    <!-- Outlined input — 14dp radius, 1.5dp focus ring -->
    <style name="Widget.KeyNest.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/kn_r_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/kn_r_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/kn_r_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/kn_r_input</item>
        <item name="boxStrokeColor">@color/kn_primary</item>
        <item name="hintTextColor">@color/kn_text_2</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <!-- Filter chip — uppercase eyebrow text -->
    <style name="Widget.KeyNest.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/kn_r_chip</item>
        <item name="chipMinHeight">@dimen/kn_chip_height</item>
        <item name="android:textAppearance">@style/Text.KeyNest.Caption</item>
    </style>

    <!-- Bottom sheet — 28dp top radius -->
    <style name="Widget.KeyNest.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.KeyNest.Sheet</item>
    </style>
    <style name="ShapeAppearance.KeyNest.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/kn_r_sheet</item>
        <item name="cornerSizeTopRight">@dimen/kn_r_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>
